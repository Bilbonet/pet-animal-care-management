<?xml version="1.0" ?>
<odoo>

    <record id="vet_appointment_email_template" model="mail.template">
        <field name="name">Vet Appointment - Report</field>
        <field
            name="model_id"
            ref="pet_animal_care_management.model_veterinary_appointment"
        />
        <field
            name="email_from"
        >{{ object.veterinarian_id.work_email or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field
            name="subject"
        >{{ object.company_id.name }} Vet Appointment Report ({{ object.name or 'n/a' }})</field>
        <field name="auto_delete" eval="True" />
        <field
            name="report_template"
            ref="pet_animal_care_management.vet_appointment_report_action"
        />
        <field
            name="report_name"
        >({{ object.name }})_{{ object.animal_id.name }}</field>
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
            <table
                style="padding-top:16px;background-color: #F1F1F1; font-family:Verdana, Arial,sans-serif; color: #454748; width: 100%; border-collapse:separate;"
                cellspacing="0"
                cellpadding="0"
                border="0"
            >
                <tbody>
                    <tr>
                        <td align="center">
                            <table
                                style="padding:16px;background-color: white; color: #454748; border-collapse:separate;"
                                width="590"
                                cellspacing="0"
                                cellpadding="0"
                                border="0"
                            >
                                <tbody>
                                    <!-- Head-->
                                    <tr>
                                        <td style="min-width:590px;" align="center">
                                            <table
                                                style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                width="590"
                                                cellspacing="0"
                                                cellpadding="0"
                                                border="0"
                                            >
                                                <tbody>
                                                    <tr>
                                                        <td valign="middle">
                                                            <span
                                                                style="font-size:10px;"
                                                            >Your Pet</span><br />
                                                            <span
                                                                style="font-size:20px;font-weight: bold;"
                                                            >
                                                                <t
                                                                    t-out="object.animal_id.name or ''"
                                                                >Pet Name</t>
                                                            </span>
                                                        </td>
                                                        <td
                                                            valign="middle"
                                                            align="right"
                                                        >
                                                            <img
                                                                src="/logo.png"
                                                                style="padding: 0px; margin: 0px; height: auto; width: 100px;"
                                                                t-att-alt="object.company_id.name or ''"
                                                            />
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td
                                                            colspan="2"
                                                            style="text-align:center;"
                                                        >
                                                            <hr
                                                                style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                                                width="100%"
                                                            />
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="min-width:590px;" align="center">
                                            <table
                                                style="min-width:590px;background-color: white; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                width="590"
                                                cellspacing="0"
                                                cellpadding="0"
                                                border="0"
                                            >
                                                <tbody>
                                                    <tr>
                                                        <td
                                                            style="font-size:13px;"
                                                            valign="top"
                                                        >
                                                            <div>
                                                                Hello <t
                                                                    t-out="object.partner_id.name or ''"
                                                                >Customer</t>,<br /><br
                                                                />
                                                                We inform you about the following Veterinary Appointment: <br
                                                                />
                                                                <p
                                                                    style="border-left:1px solid #8e0000;margin-left:30px;padding:10px 0px 10px 10px;"
                                                                >
                                                                    Code: <strong><t
                                                                            t-out="object.name or ''"
                                                                        >APPT001</t></strong><br
                                                                    />
                                                                    Date: <strong><t
                                                                            t-out="format_datetime(object.date_appointment, tz=object.partner_id.tz, dt_format='dd/MM/yyyy HH:mm') or ''"
                                                                        >01/01/2025 10:00</t></strong><br
                                                                    />
                                                                    Your Veterinarian: <a
                                                                        t-if="object.veterinarian_id.work_email"
                                                                        t-att-href="'mailto:%s?subject=Vet Appointment %s' % (object.veterinarian_id.work_email or '', object.name or '')"
                                                                    ><strong><t
                                                                                t-out="object.veterinarian_id.name or ''"
                                                                            >Vet Name</t></strong></a>
                                                                </p>
                                                                Thanks,<br />
                                                                <t
                                                                    t-if="not is_html_empty(user.signature)"
                                                                >
                                                                    <br />
                                                                    <t
                                                                        t-out="user.signature or ''"
                                                                    >--<br
                                                                        />Signature</t>
                                                                </t>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td style="text-align:center;">
                                                            <hr
                                                                style="background-color:rgb(204,204,204);border:medium none;clear:both;display:block;font-size:0px;min-height:1px;line-height:0; margin: 16px 0px 16px 0px;"
                                                                width="100%"
                                                            />
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="min-width:590px;" align="center">
                                            <table
                                                style="min-width:590px;background-color: white; font-size: 11px; padding: 0px 8px 0px 8px; border-collapse:separate;"
                                                width="590"
                                                cellspacing="0"
                                                cellpadding="0"
                                                border="0"
                                            >
                                                <tbody>
                                                    <tr>
                                                        <td
                                                            valign="middle"
                                                            align="left"
                                                        >
                                                            <t
                                                                t-out="object.company_id.name or ''"
                                                            >Company Name</t>
                                                        </td>
                                                    </tr>
                                                    <tr>
                                                        <td
                                                            style="opacity:0.7;"
                                                            valign="middle"
                                                            align="left"
                                                        >
                                                            <t
                                                                t-out="object.company_id.phone or ''"
                                                            >123456789</t>
                                                            <t
                                                                t-if="object.company_id.email"
                                                            >
                                                                | <a
                                                                    t-att-href="'mailto:%s' % (object.company_id.email or '')"
                                                                    style="color:#454748;"
                                                                ><t
                                                                        t-out="object.company_id.email or ''"
                                                                    >company@email.com</t></a>
                                                            </t>
                                                            <t
                                                                t-if="object.company_id.website"
                                                            >
                                                                | <a
                                                                    t-att-href="object.company_id.website"
                                                                    style="color:#454748;"
                                                                ><t
                                                                        t-out="object.company_id.website or ''"
                                                                    >website.com</t></a>
                                                            </t>
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                    <tr>
                        <td style="min-width:590px;" align="center">
                            <table
                                style="min-width:590px;background-color: #F1F1F1; color: #454748; padding: 8px; border-collapse:separate;"
                                width="590"
                                cellspacing="0"
                                cellpadding="0"
                                border="0"
                            >
                                <tbody>
                                    <tr>
                                        <td style="text-align:center;font-size: 13px;">
                                            No olvides visitar nuestro <a
                                                target="_blank"
                                                href="https://www.euskalmushing.com/blog/nuestro-blog-1"
                                                style="color:#875A7B;"
                                            >Blog</a>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </td>
                    </tr>
                </tbody>
            </table>
        </field>
    </record>

    <record id="vet_appointment_email_reminder" model="mail.template">
        <field name="name">Vet Appointment: Reminder</field>
        <field
            name="model_id"
            ref="pet_animal_care_management.model_veterinary_appointment"
        />
        <field
            name="subject"
        >{{ object.company_id.name }} Vet Appointment Reminder ({{ object.name or 'n/a' }})</field>
        <field
            name="email_from"
        >{{ object.veterinarian_id.work_email or user.email_formatted }}</field>
        <field name="partner_to">{{ object.partner_id.id }}</field>
        <field name="auto_delete" eval="True" />
        <field name="lang">{{ object.partner_id.lang }}</field>
        <field name="body_html" type="html">
<div>
    <p>
        Hello <t t-out="object.partner_id.name or ''">Customer</t>,<br /><br />
        This is a reminder for the below veterinary appointment :
    </p>
    <table border="0" cellpadding="0" cellspacing="0"><tr>
        <td width="130px;">
            <div
                                style="border-top-left-radius: 3px; border-top-right-radius: 3px; font-size: 12px; border-collapse: separate; text-align: center; font-weight: bold; color: #ffffff; min-height: 18px; background-color: #875A7B; border: 1px solid #875A7B;"
                            >
                Date
            </div>
            <div
                                style="font-size: 48px; min-height: auto; font-weight: bold; text-align: center; color: #5F5F5F; background-color: #F8F8F8; border: 1px solid #875A7B;padding: 0px 10px 0px 10px;"
                            >
                <t
                                    t-out="format_datetime(object.date_appointment, tz=object.partner_id.tz, dt_format='dd/MM/yyyy') or ''"
                                >01/01/2025</t>
            </div>
            <div
                                style='font-size: 12px; text-align: center; font-weight: bold; color: #ffffff; background-color: #875A7B;'
                            >
                Time
            </div>
            <div
                                style="border-collapse: separate; color: #5F5F5F; text-align: center; font-size: 40px; border-bottom-right-radius: 3px; font-weight: bold; border: 1px solid #875A7B; border-bottom-left-radius: 3px;"
                            >
                <t
                                    t-out="format_datetime(object.date_appointment, tz=object.partner_id.tz, dt_format='HH:mm') or ''"
                                >10:00</t>
            </div>
        </td>
        <td width="20px;" />
        <td style="padding-top: 5px;">
            <p><strong>Details of the vet appointment</strong></p><br />
            <ul>
                <t t-if="object.history">
                    <li>History: <t t-out="object.history" /></li>
                </t>
                <t t-if="object.diagnostic">
                    <li>Diagnostic: <t t-out="object.diagnostic" /></li>
                </t>
                <t t-if="object.treatment">
                    <li>Treatment: <t t-out="object.treatment" /></li>
                </t>
                <t t-if="object.veterinarian_id">
                    <li>Veterinarian: <strong><t
                                                t-out="object.veterinarian_id.name"
                                            /></strong>
                        <ul>
                            <li>Phone: <t
                                                    t-out="object.veterinarian_id.work_phone or ''"
                                                /></li>
                            <li>Email: <a
                                                    t-att-href="'mailto:%s?subject=Vet Appointment %s' % (object.veterinarian_id.work_email or '', object.name or '')"
                                                ><t
                                                        t-out="object.veterinarian_id.work_email or ''"
                                                    /></a></li>
                        </ul>
                    </li>
                </t>
            </ul>
        </td>
    </tr></table>
    <br />
    Thank you,
    <br />
    <div style="padding:0px;margin:auto;">
        <table cellspacing="0" cellpadding="0">
            <tbody>
                <tr>
                    <td style="padding:10px 10px 10px 0px;font-size: 12px">
                        <img
                                        src="/logo.png"
                                        style="padding: 0px; margin: 0px; height: auto; width: 100px;"
                                        t-att-alt="object.company_id.name or ''"
                                    />
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
</div>
        </field>
    </record>

</odoo>
